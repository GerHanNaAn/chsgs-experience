{
  "name": "chsgs-experience",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run assets && vite --host 127.0.0.1 --port 3003 --strictPort",
    "build": "npm run assets && vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 3003 --strictPort",
    "test": "node --test tests/*.test.js",
    "test:versions": "npm test && node --test versions/v1/tests/*.test.js"
  },
  "dependencies": { "three": "0.186.1", "vue": "3.5.44" },
  "devDependencies": { "@vitejs/plugin-vue": "5.2.3", "vite": "6.4.5" }
}
