{
  "name": "chsgs-experience",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run assets && vite --host 127.0.0.1 --port 3003 --strictPort",
    "build": "npm run assets && vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 3003 --strictPort",
    "test": "node --test tests/*.test.js",
    "test:versions": "npm test && node --test versions/v1/tests/*.test.js && npm run test:v3",
    "dev:v3": "node scripts/prepare-v3-assets.mjs && vite --config versions/v3/vite.config.js --host 127.0.0.1 --port 3004 --strictPort",
    "build:v3": "node scripts/prepare-v3-assets.mjs && vite build --config versions/v3/vite.config.js",
    "preview:v3": "vite preview --config versions/v3/vite.config.js --host 127.0.0.1 --port 3005 --strictPort",
    "test:v3": "node --test versions/v3/tests/*.test.js"
  },
  "dependencies": { "three": "0.186.1", "vue": "3.5.44" },
  "devDependencies": { "@vitejs/plugin-vue": "5.2.3", "vite": "6.4.5" }
}
